# Copy to .env.local; never commit the filled file.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com/beta
MODEL_ID=deepseek-flash
MODEL_STRUCTURED_OUTPUT=strict-tool
MODEL_TEMPERATURE=0.3
# Conservative CNY estimates; official USD pricing and actual usage are recorded separately.
MODEL_INPUT_PRICE_PER_MILLION=2.4
MODEL_OUTPUT_PRICE_PER_MILLION=9.6
MODEL_TIMEOUT_MS=60000
MODEL_MAX_OUTPUT_TOKENS=2200
ARENA_DATABASE_PATH=./data/arena.sqlite
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ARENA_SESSION_SECRET=
ARENA_RUN_BUDGET_CNY=1.5
ARENA_GLOBAL_BUDGET_CNY=70
ARENA_DAILY_VISITOR_LIMIT=6
ARENA_MAX_CONCURRENT_CALLS=3
RELEASE_VERSION=0.2.0
RELEASE_COMMIT=development
# Production requires an invite code unless public demo access is explicitly enabled.
ARENA_ACCESS_CODE=
ARENA_PUBLIC_DEMO=false
# Set to the exact HTTPS origin behind a reverse proxy; local requests may leave it empty.
ARENA_PUBLIC_ORIGIN=
# Enable only in a persistent Node.js process; serverless background execution is not guaranteed.
ARENA_WORKER_ENABLED=false
