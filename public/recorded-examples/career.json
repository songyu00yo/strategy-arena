        "strategies": [
          {
            "id": "A",
            "title": "以留任为照护基准",
            "thesis": "优先核实留任能否持续保障照护，再与外地和远程的实际可支配收入及照护安排比较；两周内书面答复，关键条件未知前不承诺可行。",
            "steps": [
              "盘点父母每日照护需求及现有留任安排，确认未来两周和之后是否能持续衔接。",
              "核实留任、外地及远程的税后收入、住房和交通等费用；询问远程许可及书面答复期限。",
              "核实外地或远程期间的照护安排及相关人员的明确承诺；没有可靠衔接时不选择会中断照护的安排。",
              "按家庭稳定优先、可支配收入其次比较三项；预留等待回复和复核时间，两周内提交书面答复。"
            ],
            "claims": [
              {
                "id": "A-claim-1",
                "text": "当前税前月薪为10000元，外地邀约为13000元；两地月租分别约2000元和3500元。",
                "status": "unknown",
                "sourceIds": []
              },
              {
                "id": "A-claim-2",
                "text": "仅比较税前工资与房租，外地每月多1500元；税费、搬家及其他费用未计入，不能视为实际收入差。",
                "status": "estimate",
                "sourceIds": []
              },
              {
                "id": "A-claim-3",
                "text": "留任能否持续覆盖父母日常照护尚待确认；其他照护者目前没有承诺。",
                "status": "unknown",
                "sourceIds": []
              }
            ],
            "resources": "依靠现有照护安排及向雇主、相关人员询问；税费、交通、搬家等费用与耗时未知，须核实后计入总预算15000元及总工时20小时。",
            "firstAction": "列出父母每日照护需求和目前负责方式，确认留任下是否存在照护空档。",
            "failureCondition": "如留任不能保证照护连续，不能将其作为可行结论；若两周内三项均无法确认满足照护与书面答复要求，说明无法确定可行方案并请求必要条件调整。",
            "estimatedCost": null,
            "estimatedHours": null
          },
          {
            "id": "B",
            "title": "分步核实外地工作，照护落实前不接受",
            "thesis": "先核实连续照护和到手收入，再与留任、远程比较；没有可靠照护安排时，不能接受须搬迁的工作。",
            "steps": [
              "确认父母每日照护需求、现有安排及搬迁后的缺口，了解可承担者的意愿、能力和费用。",
              "向新雇主核实书面薪酬、工作地点、入职期限和远程可能性；向现公司核实留任及远程条件。",
              "核算三条路线税后收入，扣除住房、双城生活、照护、搬家及其他新增费用；费用未知时保留缺口。",
              "在两周期限前预留时间检查照护衔接、比较结果并书面答复；若照护无法落实，不接受需搬迁的邀约。"
